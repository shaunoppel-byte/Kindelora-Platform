      "approved": false
    },
    {
      "id": "a4-05-09",
      "theme": "Financial calm",
      "text": "I can be honest about a financial concern without defining myself by it.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-05-10",
      "theme": "Financial calm",
      "text": "I can focus on the next responsible step rather than demanding instant certainty.",
