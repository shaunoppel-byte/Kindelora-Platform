      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-03",
      "theme": "Meaningful contribution",
      "text": "I can ask what would actually help before offering a solution.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-04",
      "theme": "Meaningful contribution",
      "text": "I can recognise the value of work that supports others behind the scenes.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-05",
      "theme": "Meaningful contribution",
      "text": "I can choose a small act of service that fits my time and capacity.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-06",
      "theme": "Meaningful contribution",
      "text": "I can share useful knowledge without expecting everyone to follow my approach.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-07",
      "theme": "Meaningful contribution",
      "text": "I can take pride in doing an ordinary responsibility with care.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-08",
      "theme": "Meaningful contribution",
      "text": "I can notice a need in my community and explore one realistic way to respond.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-09",
      "theme": "Meaningful contribution",
      "text": "I can encourage another person's contribution instead of competing for credit.",
