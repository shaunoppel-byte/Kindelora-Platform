      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-01",
      "theme": "Meaningful contribution",
      "text": "I can use one skill I have to make someone else's task a little easier.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-10-02",
      "theme": "Meaningful contribution",
      "text": "I can contribute quietly without needing to be the centre of attention.",
