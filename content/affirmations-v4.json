  "scripts": [
    {
      "id": "a4-01-01",
      "theme": "Finding steadiness",
      "text": "I can find a steady place in the middle of a busy day by noticing what is actually happening now.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-02",
      "theme": "Finding steadiness",
      "text": "I can make a small plan for the next hour without needing to organise the whole future.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-03",
      "theme": "Finding steadiness",
      "text": "I can let my breathing settle before I decide how to respond.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-04",
      "theme": "Finding steadiness",
      "text": "I can choose a familiar routine when everything else feels new.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-05",
      "theme": "Finding steadiness",
      "text": "I can notice the difference between an urgent request and an important one.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-06",
      "theme": "Finding steadiness",
      "text": "I can ask what would make this moment easier, then begin with that.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-07",
      "theme": "Finding steadiness",
      "text": "I can keep my attention on one practical step while other questions remain unanswered.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-08",
      "theme": "Finding steadiness",
      "text": "I can create a little space between hearing difficult news and making a decision.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-09",
      "theme": "Finding steadiness",
      "text": "I can remember that a slower response can still be a thoughtful response.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-01-10",
      "theme": "Finding steadiness",
      "text": "I can return to the things that support me without expecting them to solve everything.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-01",
      "theme": "Kindness to strangers",
      "text": "I can greet someone warmly without knowing what kind of day they are having.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-02",
      "theme": "Kindness to strangers",
      "text": "I can leave room for another person to finish their thought.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-03",
      "theme": "Kindness to strangers",
      "text": "I can thank someone for work that is easy to overlook.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-04",
      "theme": "Kindness to strangers",
      "text": "I can offer a small courtesy without needing recognition in return.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-05",
      "theme": "Kindness to strangers",
      "text": "I can be patient when someone is learning a task that feels familiar to me.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-06",
      "theme": "Kindness to strangers",
      "text": "I can give someone the benefit of a clarifying question before making an assumption.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-07",
      "theme": "Kindness to strangers",
      "text": "I can remember that the person in front of me has a life beyond this interaction.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-08",
      "theme": "Kindness to strangers",
      "text": "I can choose a respectful tone even when I need to raise a concern.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-09",
      "theme": "Kindness to strangers",
      "text": "I can make space for another person when the day feels crowded.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-02-10",
      "theme": "Kindness to strangers",
      "text": "I can let a brief interaction leave someone feeling a little more welcome.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-01",
      "theme": "Releasing comparison",
      "text": "I can notice someone else's success without turning it into a criticism of my own path.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-02",
      "theme": "Releasing comparison",
      "text": "I can appreciate what inspires me in another person while keeping my own priorities.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-03",
      "theme": "Releasing comparison",
      "text": "I can remember that I rarely see the full story behind someone else's progress.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-04",
      "theme": "Releasing comparison",
      "text": "I can choose a measure of success that reflects what matters to me.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-05",
      "theme": "Releasing comparison",
      "text": "I can celebrate the skills I am building, even if they are different from someone else's.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-06",
      "theme": "Releasing comparison",
      "text": "I can let another person's timeline be theirs and mine be mine.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-07",
      "theme": "Releasing comparison",
      "text": "I can step away from a comparison that leaves me feeling smaller.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-08",
      "theme": "Releasing comparison",
      "text": "I can be curious about what I admire without needing to copy it.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-09",
      "theme": "Releasing comparison",
      "text": "I can acknowledge the work I have done without ranking it against someone else's.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-03-10",
      "theme": "Releasing comparison",
      "text": "I can return my attention to the choices that are actually mine to make.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-01",
      "theme": "Navigating difficult conversations",
      "text": "I can prepare what matters most before I begin a challenging conversation.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-02",
      "theme": "Navigating difficult conversations",
      "text": "I can speak clearly without trying to control how every word will be received.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-03",
      "theme": "Navigating difficult conversations",
      "text": "I can listen for understanding before deciding whether I agree.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-04",
      "theme": "Navigating difficult conversations",
      "text": "I can ask for a pause if I need time to respond with care.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-05",
      "theme": "Navigating difficult conversations",
      "text": "I can explain how something affected me without assigning motives I cannot know.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-06",
      "theme": "Navigating difficult conversations",
      "text": "I can stay respectful while holding a different point of view.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-07",
      "theme": "Navigating difficult conversations",
      "text": "I can ask what the other person understood rather than assuming my message was clear.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-08",
      "theme": "Navigating difficult conversations",
      "text": "I can acknowledge one valid point without abandoning my own perspective.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-09",
      "theme": "Navigating difficult conversations",
      "text": "I can leave a conversation unfinished when more reflection would help.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-04-10",
      "theme": "Navigating difficult conversations",
      "text": "I can aim for honesty and connection instead of winning every exchange.",
      "status": "editorial-review",
      "audioMale": null,
      "audioFemale": null,
      "approved": false
    },
    {
      "id": "a4-05-01",
      "theme": "Financial calm",
      "text": "I can look at one part of my finances today without judging myself for what I find.",
